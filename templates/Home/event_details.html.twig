{% extends 'homebase.html.twig' %}

{% block title %}{{ reservation.event.name }} - ENCG Events{% endblock %}

{% block body %}
    <section class="event-details container">
        <div class="event-header">
            <a href="{{ path('app_home') }}" class="back-btn">
                <i class='bx bx-arrow-back'></i> Retour aux événements
            </a>
        </div>



            <div class="event-info">
                <h1>{{ reservation.event.name }}</h1>

                <div class="event-meta">
                    <div class="meta-item">
                        <i class='bx bx-building'></i>
                        <strong>Salle:</strong> {{ reservation.room.name }}
                    </div>

                    <div class="meta-item">
                        <i class='bx bx-calendar-event'></i>
                        <strong>Date de début:</strong> {{ reservation.startTime|date('d/m/Y à H:i') }}
                    </div>

                    <div class="meta-item">
                        <i class='bx bx-calendar-x'></i>
                        <strong>Date de fin:</strong> {{ reservation.endTime|date('d/m/Y à H:i') }}
                    </div>

                    <div class="meta-item">
                        <i class='bx bx-time'></i>
                        <strong>Durée:</strong>
                        {% set diff = date(reservation.endTime).diff(date(reservation.startTime)) %}
                        {% if diff.days > 0 %}
                            {{ diff.days }} jour(s)
                        {% elseif diff.h > 0 %}
                            {{ diff.h }} heure(s)
                        {% else %}
                            {{ diff.i }} minute(s)
                        {% endif %}
                    </div>

                    {% if reservation.user %}
                        <div class="meta-item">
                            <i class='bx bx-user'></i>
                            <strong>Organisateur:</strong> {{ reservation.user.email }}
                        </div>
                    {% endif %}
                </div>

                {% if reservation.event.description %}
                    <div class="event-description">
                        <h3>Description</h3>
                        <p>{{ reservation.event.description|nl2br }}</p>
                    </div>
                {% endif %}

                <div class="event-status">
                    {% set now = date() %}
                    {% if reservation.startTime > now %}
                        <span class="status upcoming">
                            <i class='bx bx-time-five'></i>
                            Événement à venir
                        </span>
                    {% elseif reservation.startTime <= now and reservation.endTime > now %}
                        <span class="status ongoing">
                            <i class='bx bx-play-circle'></i>
                            En cours
                        </span>
                    {% else %}
                        <span class="status finished">
                            <i class='bx bx-check-circle'></i>
                            Terminé
                        </span>
                    {% endif %}
                </div>

                {% if app.user %}
                    <div class="event-actions">
                        {% if reservation.startTime > now %}
                            <button class="btn btn-primary" onclick="showInterestModal()">
                                <i class='bx bx-heart'></i>
                                Marquer comme intéressé
                            </button>
                        {% endif %}

                        <button class="btn btn-secondary" onclick="shareEvent()">
                            <i class='bx bx-share'></i>
                            Partager
                        </button>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    <style>
        .event-details {
            padding: 2rem 0;
            min-height: 70vh;
        }

        .event-header {
            margin-bottom: 2rem;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            color: #2c5aa0;
            text-decoration: none;
            font-weight: 500;
            transition: opacity 0.3s;
        }

        .back-btn:hover {
            opacity: 0.8;
            text-decoration: none;
        }

        .back-btn i {
            margin-right: 0.5rem;
            font-size: 1.2rem;
        }

        .event-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: start;
        }

        .event-image img {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .event-info h1 {
            color: #2c5aa0;
            margin-bottom: 1.5rem;
            font-size: 2.5rem;
        }

        .event-meta {
            margin-bottom: 2rem;
        }

        .meta-item {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
            padding: 0.5rem 0;
        }

        .meta-item i {
            color: #2c5aa0;
            font-size: 1.2rem;
            margin-right: 1rem;
            width: 24px;
        }

        .event-description {
            margin-bottom: 2rem;
        }

        .event-description h3 {
            color: #2c5aa0;
            margin-bottom: 1rem;
        }

        .event-status {
            margin-bottom: 2rem;
        }

        .status {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 500;
        }

        .status i {
            margin-right: 0.5rem;
        }

        .status.upcoming {
            background-color: #e3f2fd;
            color: #1976d2;
        }

        .status.ongoing {
            background-color: #e8f5e8;
            color: #388e3c;
        }

        .status.finished {
            background-color: #fafafa;
            color: #616161;
        }

        .event-actions {
            display: flex;
            gap: 1rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            padding: 0.8rem 1.5rem;
            border: none;
            border-radius: 5px;
            text-decoration: none;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn i {
            margin-right: 0.5rem;
        }

        .btn-primary {
            background-color: #2c5aa0;
            color: white;
        }

        .btn-primary:hover {
            background-color: #1e4080;
        }

        .btn-secondary {
            background-color: #f5f5f5;
            color: #333;
        }

        .btn-secondary:hover {
            background-color: #e0e0e0;
        }

        @media (max-width: 768px) {
            .event-content {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .event-info h1 {
                font-size: 2rem;
            }

            .event-actions {
                flex-direction: column;
            }
        }
    </style>

    <script>
        function showInterestModal() {
            alert('Fonctionnalité à venir : Marquer comme intéressé');
            // Vous pouvez implémenter une modale ici
        }

        function shareEvent() {
            if (navigator.share) {
                navigator.share({
                    title: '{{ reservation.event.name }}',
                    text: 'Découvrez cet événement à l\'ENCG Agadir',
                    url: window.location.href
                });
            } else {
                // Fallback pour les navigateurs qui ne supportent pas navigator.share
                navigator.clipboard.writeText(window.location.href);
                alert('Lien copié dans le presse-papiers !');
            }
        }
    </script>
{% endblock %}